# Web Query Tool Environment Variables
# Copy this file to .env and fill in your values

# Database Connection Strings
POSTGRES_CONNECTION_STRING=Host=your-postgres-server;Port=5432;Database=your_db;Username=your_user;Password=your_password
MYSQL_CONNECTION_STRING=Server=your-mysql-server;Port=3306;Database=your_db;Uid=your_user;Pwd=your_password
SQLSERVER_CONNECTION_STRING=Server=your-sqlserver;Database=your_db;User Id=your_user;Password=your_password;TrustServerCertificate=True
REDSHIFT_CONNECTION_STRING=Server=your-redshift-cluster.region.redshift.amazonaws.com;Port=5439;Database=your_db;User Id=your_user;Password=your_password

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-characters
JWT_ISSUER=WebQueryTool
JWT_AUDIENCE=WebQueryToolClient
JWT_EXPIRATION_MINUTES=60

# Redis Configuration (for SignalR backplane)
REDIS_CONNECTION_STRING=localhost:6379

# Application Settings
ASPNETCORE_ENVIRONMENT=Production
LOG_LEVEL=Information
